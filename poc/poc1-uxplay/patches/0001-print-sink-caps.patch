+/* iScrMirror patch: report the real size of every frame the video sink is about to draw, so that a
+ * controlling program can map window coordinates to device coordinates (the size changes when the
+ * phone rotates). Output format:  iScrMirror: sink-caps <w>x<h> par <n>/<d>  */
+static GstPadProbeReturn
+isr_caps_probe(GstPad *pad, GstPadProbeInfo *info, gpointer user_data) {
+    GstEvent *event = GST_PAD_PROBE_INFO_EVENT(info);
+    if (event && GST_EVENT_TYPE(event) == GST_EVENT_CAPS) {
+        GstCaps *caps = NULL;
+        gst_event_parse_caps(event, &caps);
+        if (caps && gst_caps_get_size(caps) > 0) {
+            GstStructure *s = gst_caps_get_structure(caps, 0);
+            int w = 0, h = 0, pn = 1, pd = 1;
+            if (gst_structure_get_int(s, "width", &w) && gst_structure_get_int(s, "height", &h)) {
+                gst_structure_get_fraction(s, "pixel-aspect-ratio", &pn, &pd);
+                printf("iScrMirror: sink-caps %dx%d par %d/%d\n", w, h, pn, pd);
+                fflush(stdout);
+            }
+        }
+    }
+    return GST_PAD_PROBE_OK;
+}

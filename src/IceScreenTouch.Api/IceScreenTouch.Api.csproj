<Project Sdk="Microsoft.NET.Sdk">

  <!-- The automation API: transport-independent controller (serialization of operations, coordinates, limits,
       arbitration with the user). The HTTP / WebSocket server (ASP.NET Core) is added on top of it. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- LibraryImport (the integrity label of the secret files) generates unsafe marshalling code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Kestrel serves the API on 127.0.0.1 (a separate server from the probe page server). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- The OpenAPI document served at GET /v1/openapi.json (replace the file to change the document). -->
    <EmbeddedResource Include="openapi.json" LogicalName="IceScreenTouch.Api.openapi.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="IceScreenTouch.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Encodes and shrinks the screenshot (PNG, JPEG). The same version Avalonia.Skia brings into the app, so nothing new
         is shipped; SkiaSharp pulls the native library of the platform it runs on. -->
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IceScreenTouch.Core\IceScreenTouch.Core.csproj" />
  </ItemGroup>

</Project>

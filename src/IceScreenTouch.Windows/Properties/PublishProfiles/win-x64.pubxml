<Project>
  <!-- The distribution build: one self-contained IceScreenTouch.exe (no .NET install needed), trimmed and
       compressed. Run tools/publish.ps1, which also checks what went into the bundle and runs the
       executable's self-check. Native libraries (Skia, HarfBuzz) are extracted to %TEMP%\.net on first run. -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <DebugType>none</DebugType>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\artifacts\publish\win-x64\</PublishDir>
  </PropertyGroup>
</Project>

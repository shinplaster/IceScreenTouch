<Project Sdk="Microsoft.NET.Sdk">

  <!-- Cross-platform UI (Avalonia): views and view models only. OS-specific services are
       wired in by a platform head such as IceScreenTouch.Windows. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- English is in the main assembly; other languages (ja) are satellite assemblies. -->
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <!-- User-facing text (Resources/Strings*.resx) with a generated, public Strings class: the views use
       {x:Static res:Strings.Name}, the code Strings.Name and Loc.Format. -->
  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings.resx">
      <StronglyTypedFileName>$(IntermediateOutputPath)Strings.Designer.cs</StronglyTypedFileName>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>IceScreenTouch.App.Resources</StronglyTypedNamespace>
      <StronglyTypedClassName>Strings</StronglyTypedClassName>
      <PublicClass>true</PublicClass>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <!-- The About tab shows the license and the third-party notices (tools/publish.ps1 keeps the notices in step
       with what the single-file bundle holds). -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\LICENSE" LogicalName="IceScreenTouch.App.LICENSE.txt" />
    <EmbeddedResource Include="..\..\THIRD-PARTY-NOTICES.txt" LogicalName="IceScreenTouch.App.THIRD-PARTY-NOTICES.txt" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="IceScreenTouch.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IceScreenTouch.Core\IceScreenTouch.Core.csproj" />
  </ItemGroup>

</Project>
